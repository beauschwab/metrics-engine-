{
  // Everything that runs in Node rather than in a browser: the registry API,
  // the Dremio gateway and the MCP tool server.
  //
  // This project exists because `server/` was not typechecked by anything for
  // its entire life. `tsconfig.json` includes only `src`, and the harness
  // project adds `e2e` — so a deliberate `const x: number = "no"` in
  // `server/live.ts` passed `npm run typecheck` cleanly. Vitest transpiles
  // without checking, so the server tests could not catch it either: the only
  // type errors that would ever have surfaced were the ones that also happened
  // to break at run time.
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["node"],
    // `bundler` resolution, inherited settings and all: tsx and vitest both
    // resolve extensionless specifiers and `exports` maps the same way a
    // bundler does, which is what `keel-engine/parse` needs. An earlier comment
    // here claimed this project used Node resolution and turned off
    // `allowImportingTsExtensions`; it did neither, and nothing depended on the
    // claim — but a config that lies is worse than one that says nothing.
    "moduleResolution": "bundler",
    "lib": ["ES2022"]
  },
  "include": ["server", "mcp"],
  "exclude": []
}
