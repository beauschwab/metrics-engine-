{
  "name": "metrics-engine",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.7",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev --filter=registry-web",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "e2e": "turbo run e2e",
    "verify": "turbo run typecheck test e2e verify",
    "conformance": "npm run test --workspace=keel-engine -- conformance",
    "registry": "turbo run start --filter=keel-registry",
    "registry:mcp": "turbo run start --filter=registry-mcp",
    "chartroom:api": "turbo run start --filter=chartroom-api",
    "chartroom:studio": "turbo run dev --filter=chartroom-studio",
    "chartroom:mcp": "turbo run start --filter=chartroom-mcp",
    "setup:agent": "npm run setup --workspace=chartroom-agent",
    "setup:python": "uv sync --frozen"
  },
  "devDependencies": {
    "turbo": "^2.5.8",
    "typescript": "^5.8.3"
  }
}
