        "selector": "JSXOpeningElement[name.name='ForecastChart'] > JSXAttribute > JSXIdentifier[name!=/^(?:actual|optimistic|average|pessimistic|labels|splitLabel|height|yTicks|yFormat|color|style|key|ref|className|style|children)$/]",
        "message": "<ForecastChart> doesn't accept that prop. Declared props: actual, optimistic, average, pessimistic, labels, splitLabel, height, yTicks, yFormat, color, style."
