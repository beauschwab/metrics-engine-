{
  "plugins": [
    "react",
    "import"
  ],
  "rules": {
    "react/forbid-elements": [
      "warn",
      {
        "forbid": []
      }
    ],
    "no-restricted-imports": [
      "warn",
      {
        "patterns": [
          {
            "group": [
              "components/ai/**",
              "components/core/**",
              "components/data/**",
              "components/flow/**",
              "components/forms/**",
              "components/grid/**",
              "ui_kits/risk-terminal/**"
            ],
            "message": "Import design-system components from 'index.js', not component internals."
          }
        ]
      }
    ],
    "no-restricted-syntax": [
      "warn",
      {
        "selector": "Literal[value=/#[0-9a-fA-F]{3,8}\\b/]",
        "message": "Raw hex color — use a design-system color token via var()."
      },
      {
        "selector": "Literal[value=/\\b\\d+px\\b/]",
        "message": "Raw px value — use a design-system spacing token via var()."
      },
      {
        "selector": "Literal[value=/font-family\\s*:\\s*(?!['\\\"]?(?:Inter))/i]",
        "message": "Font not provided by the design system. Available: Inter."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIInsight'] > JSXAttribute > JSXIdentifier[name!=/^(?:title|children|severity|confidence|sources|actions|compact|style|key|ref|className|style|children)$/]",
        "message": "<AIInsight> doesn't accept that prop. Declared props: title, children, severity, confidence, sources, actions, compact, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIInsight'] > JSXAttribute[name.name='severity'] > Literal[value!=/^(?:info|positive|warning|critical)$/]",
        "message": "<AIInsight> severity must be one of 'info' | 'positive' | 'warning' | 'critical'."
      },
      {
        "selector": "JSXOpeningElement[name.name='AIPromptBar'] > JSXAttribute > JSXIdentifier[name!=/^(?:placeholder|value|onChange|onSubmit|suggestions|busy|style|key|ref|className|style|children)$/]",
        "message": "<AIPromptBar> doesn't accept that prop. Declared props: placeholder, value, onChange, onSubmit, suggestions, busy, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute > JSXIdentifier[name!=/^(?:tone|solid|dot|size|children|key|ref|className|style|children)$/]",
        "message": "<Badge> doesn't accept that prop. Declared props: tone, solid, dot, size, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='tone'] > Literal[value!=/^(?:neutral|brand|up|down|warning|danger|info|ai)$/]",
        "message": "<Badge> tone must be one of 'neutral' | 'brand' | 'up' | 'down' | 'warning' | 'danger' | 'info' | 'ai'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Badge'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md)$/]",
        "message": "<Badge> size must be one of 'sm' | 'md'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute > JSXIdentifier[name!=/^(?:variant|size|iconLeft|iconRight|disabled|loading|full|children|key|ref|className|style|children)$/]",
        "message": "<Button> doesn't accept that prop. Declared props: variant, size, iconLeft, iconRight, disabled, loading, full, children."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='variant'] > Literal[value!=/^(?:primary|secondary|ghost|danger)$/]",
        "message": "<Button> variant must be one of 'primary' | 'secondary' | 'ghost' | 'danger'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Button'] > JSXAttribute[name.name='size'] > Literal[value!=/^(?:sm|md|lg)$/]",
        "message": "<Button> size must be one of 'sm' | 'md' | 'lg'."
      },
      {
        "selector": "JSXOpeningElement[name.name='Checkbox'] > JSXAttribute > JSXIdentifier[name!=/^(?:checked|indeterminate|onChange|disabled|label|size|key|ref|className|style|children)$/]",
        "message": "<Checkbox> doesn't accept that prop. Declared props: checked, indeterminate, onChange, disabled, label, size."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColumnDatum'] > JSXAttribute > JSXIdentifier[name!=/^(?:label|value|type|key|ref|className|style|children)$/]",
        "message": "<ColumnDatum> doesn't accept that prop. Declared props: label, value, type."
      },
      {
        "selector": "JSXOpeningElement[name.name='ColumnDatum'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:actual|prev|plan|forecast)$/]",
        "message": "<ColumnDatum> type must be one of 'actual' | 'prev' | 'plan' | 'forecast'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GridColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|type|pinned|width|align|muted|strong|sortable|agg|format|sortValue|barMax|accent|barColor|invert|suffix|prefix|decimals|barWidth|render|key|ref|className|style|children)$/]",
        "message": "<GridColumn> doesn't accept that prop. Declared props: key, label, type, pinned, width, align, muted, strong, sortable, agg, format, sortValue, barMax, accent, barColor, invert, suffix, prefix, decimals, barWidth, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='GridColumn'] > JSXAttribute[name.name='type'] > Literal[value!=/^(?:text|number|delta|bar|variance|spark)$/]",
        "message": "<GridColumn> type must be one of 'text' | 'number' | 'delta' | 'bar' | 'variance' | 'spark'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GridColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<GridColumn> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='GridColumn'] > JSXAttribute[name.name='agg'] > Literal[value!=/^(?:sum|avg|none)$/]",
        "message": "<GridColumn> agg must be one of 'sum' | 'avg' | 'none'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataColumn'] > JSXAttribute > JSXIdentifier[name!=/^(?:key|label|numeric|align|width|muted|strong|render|key|ref|className|style|children)$/]",
        "message": "<DataColumn> doesn't accept that prop. Declared props: key, label, numeric, align, width, muted, strong, render."
      },
      {
        "selector": "JSXOpeningElement[name.name='DataColumn'] > JSXAttribute[name.name='align'] > Literal[value!=/^(?:left|right|center)$/]",
        "message": "<DataColumn> align must be one of 'left' | 'right' | 'center'."
      },
      {
        "selector": "JSXOpeningElement[name.name='DonutGauge'] > JSXAttribute > JSXIdentifier[name!=/^(?:value|max|size|thickness|label|center|color|threshold|hover|detail|style|key|ref|className|style|children)$/]",
        "message": "<DonutGauge> doesn't accept that prop. Declared props: value, max, size, thickness, label, center, color, threshold, hover, detail, style."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlowNode'] > JSXAttribute > JSXIdentifier[name!=/^(?:id|x|y|w|h|kind|label|value|delta|invert|accent|op|sub|spark|breakdown|note|key|ref|className|style|children)$/]",
        "message": "<FlowNode> doesn't accept that prop. Declared props: id, x, y, w, h, kind, label, value, delta, invert, accent, op, sub, spark, breakdown, note."
      },
      {
        "selector": "JSXOpeningElement[name.name='FlowNode'] > JSXAttribute[name.name='kind'] > Literal[value!=/^(?:driver|result|op)$/]",
        "message": "<FlowNode> kind must be one of 'driver' | 'result' | 'op'."
