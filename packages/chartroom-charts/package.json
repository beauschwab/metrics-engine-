{
  "name": "chartroom-charts",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "Evil Charts (Recharts, MIT) landed as source and signed to the widget contract: ten governed chart widgets a reader adds to a dashboard from a grid selection. Presentation only — no fetching.",
