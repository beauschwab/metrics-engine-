{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["node"]
  },
  // The server consumes the engine and the registry's db/dialect layer as
  // source, exactly as `server/` itself does — see ADR-4.
  "include": ["src", "test", "../../src/engine", "../../server"]
}
